# Client-side API base URLs (PUBLIC — Vite inlines VITE_* into the shipped bundle)
VITE_OPENFOODFACTS_API_BASE=https://calorieintaketracker.vercel.app/api/openfoodfacts
VITE_FOODS_API_BASE=https://calorieintaketracker.vercel.app/api/foods
VITE_OPENROUTER_API_BASE=https://calorieintaketracker.vercel.app/api/openrouter
VITE_PUSH_API_BASE=https://calorieintaketracker.vercel.app/api/push
VITE_AI_CHAT_RAG_ENABLED=true
# Optional client-side override for grounded lookup calls only
VITE_OPENROUTER_GROUNDING_MODEL=openai/gpt-4.1-mini

# ---------------------------------------------------------------------------
# Vercel server-side environment variables (NEVER prefix with VITE_)
# Invariant: SUPABASE_SERVICE_ROLE_KEY NEVER lives on Vercel.
# ---------------------------------------------------------------------------

# Supabase catalog + push RPCs (read-only ANON / publishable key only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Server-only shared secret verified inside private.push_config by the narrow
# register_push_device / unregister_push_device SECURITY DEFINER RPCs
PUSH_RPC_SECRET=replace_with_strong_random_secret

# OpenFoodFacts barcode lookup proxy (api/openfoodfacts.js)
OPENFOODFACTS_USER_AGENT=EnergyMapTracker/0.1 (contact@example.com)

# OpenRouter AI parsing proxy (api/openrouter.js)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_GROUNDING_MODEL=openai/gpt-4.1-mini
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_GROUNDING_FALLBACK_MODELS=
OPENROUTER_MAX_TOKENS_EXTRACTION=2400
OPENROUTER_MAX_TOKENS_PRESENTATION=1600
OPENROUTER_MAX_TOKENS_GROUNDING=800
ALLOWED_ORIGINS=https://your-app.example

# Upstash Redis per-IP rate limiting (api/openrouter.js + api/push/*)
# REQUIRED in production: without BOTH values the limiter is skipped.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
OPENROUTER_RATE_LIMIT_MAX_REQUESTS=15
OPENROUTER_RATE_LIMIT_WINDOW_SECONDS=60
OPENROUTER_RATE_LIMIT_FAIL_CLOSED=true
PUSH_RATE_LIMIT_MAX_REQUESTS=20
PUSH_RATE_LIMIT_WINDOW_SECONDS=60
PUSH_RATE_LIMIT_FAIL_CLOSED=true

# ---------------------------------------------------------------------------
# Local maintainer-only secrets (NEVER deploy to Vercel)
# Used exclusively by offline catalog seeding and scripts/push/send-announcement.js
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.energymap.tracker
APNS_USE_SANDBOX=false
