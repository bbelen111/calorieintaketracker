{
  "name": "energy-map-calculator",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first calorie and energy-balance tracker for iOS and Android that rebuilds your true Total Daily Energy Expenditure every day.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/bbelen111/calorieintaketracker.git"
  },
  "author": "Brendon Justine Alvero Belen",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-include=\"src/**/*.jsx\" --test-coverage-lines=75 --test-coverage-functions=75 --test-coverage-branches=63",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "test:ui:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "lint:ci": "eslint src --ext .js,.jsx,.ts,.tsx --config eslint.ci.config.js",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx,json,css,md}",
    "licenses:generate": "node scripts/licenses/generate-notices.js",
    "db:food:audit": "node scripts/food-db/index.js",
    "db:food:clean:dry": "node scripts/food-db/index.js --clean --dry-run",
    "db:food:clean": "node scripts/food-db/index.js --clean --replace",
    "db:food:build": "node scripts/food-db/build.js",
    "db:food:enrich": "node scripts/food-db/enrich-nutrients.js",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:copy": "npm run build && npx cap copy ios",
    "ios:open": "npx cap open ios",
    "ios:run": "bash scripts/ios/run-simulator.sh",
    "ios:device": "npx cap run ios",
    "ios:live": "npx cap run ios --live-reload --port 5173"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/barcode-scanner": "^3.0.2",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.0.1",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-health": "^8.2.5",
    "@capgo/capacitor-navigation-bar": "^8.0.16",
    "@fontsource/barlow": "^5.2.8",
    "dexie": "^4.2.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.562.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  }
}
